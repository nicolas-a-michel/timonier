{
  "name": "@timonier/webview",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode tracking && vite build --mode whiteboard && vite build --mode performance",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:a11y": "playwright test",
    "bench:map": "BENCH=1 playwright test --workers=1 map.perf.ts",
    "bench:whiteboard": "BENCH=1 playwright test --workers=1 whiteboard.perf.ts",
    "screenshots": "SHOTS=1 playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
