{
  "name": "timonier",
  "displayName": "Timonier",
  "description": "%extension.description%",
  "version": "0.1.2",
  "publisher": "NicolasMichel",
  "license": "MIT",
  "icon": "media/icon.png",
  "preview": true,
  "homepage": "https://github.com/nicolas-a-michel/timonier#readme",
  "bugs": {
    "url": "https://github.com/nicolas-a-michel/timonier/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolas-a-michel/timonier.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    }
  },
  "categories": [
    "Visualization",
    "AI"
  ],
  "keywords": [
    "ai",
    "agents",
    "architecture",
    "mcp",
    "claude",
    "code map",
    "opentelemetry"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.timonier"
  ],
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timonier",
          "title": "Timonier",
          "icon": "media/timonier.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "timonier-journal",
          "title": "%container.journal.title%",
          "icon": "media/timonier.svg"
        }
      ]
    },
    "views": {
      "timonier": [
        {
          "id": "timonier.home",
          "name": "%view.home.name%",
          "icon": "media/timonier.svg",
          "contextualTitle": "Timonier",
          "type": "webview"
        }
      ],
      "timonier-journal": [
        {
          "type": "webview",
          "id": "timonier.tracking",
          "name": "%view.tracking.name%",
          "icon": "media/timonier.svg",
          "contextualTitle": "Timonier"
        }
      ]
    },
    "commands": [
      {
        "command": "timonier.openMap",
        "title": "%command.openMap.title%",
        "category": "Timonier",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "timonier.openWhiteboard",
        "title": "%command.openWhiteboard.title%",
        "category": "Timonier",
        "icon": "$(edit)"
      },
      {
        "command": "timonier.openPerformance",
        "title": "%command.openPerformance.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.runTests",
        "title": "%command.runTests.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.installScip",
        "title": "%command.installScip.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.openWorkflow",
        "title": "%command.openWorkflow.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.undo",
        "title": "%command.whiteboard.undo.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.redo",
        "title": "%command.whiteboard.redo.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.select",
        "title": "%command.whiteboard.select.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.pen",
        "title": "%command.whiteboard.pen.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.eraser",
        "title": "%command.whiteboard.eraser.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.arrow",
        "title": "%command.whiteboard.arrow.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.addBox",
        "title": "%command.whiteboard.addBox.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.addZone",
        "title": "%command.whiteboard.addZone.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.addNote",
        "title": "%command.whiteboard.addNote.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.addBudget",
        "title": "%command.whiteboard.addBudget.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.deleteSelection",
        "title": "%command.whiteboard.deleteSelection.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.fitView",
        "title": "%command.whiteboard.fitView.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.zoomIn",
        "title": "%command.whiteboard.zoomIn.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whiteboard.zoomOut",
        "title": "%command.whiteboard.zoomOut.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.restartDaemon",
        "title": "%command.restartDaemon.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.showLog",
        "title": "%command.showLog.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.installCommandLine",
        "title": "%command.installCommandLine.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.fitView",
        "title": "%command.map.fitView.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.zoomIn",
        "title": "%command.map.zoomIn.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.zoomOut",
        "title": "%command.map.zoomOut.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.closeAll",
        "title": "%command.map.closeAll.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.moveSelection",
        "title": "%command.map.moveSelection.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.resetLayout",
        "title": "%command.map.resetLayout.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.toggle",
        "title": "%command.map.toggle.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.openCode",
        "title": "%command.map.openCode.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.onlyChanges",
        "title": "%command.map.onlyChanges.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.reviewDetails",
        "title": "%command.map.reviewDetails.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.reviewDebt",
        "title": "%command.map.reviewDebt.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.compareIntent",
        "title": "%command.map.compareIntent.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.showPerformance",
        "title": "%command.map.showPerformance.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.certainty",
        "title": "%command.map.certainty.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.map.rename",
        "title": "%command.map.rename.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.markReviewed",
        "title": "%command.markReviewed.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.whereToLook",
        "title": "%command.whereToLook.title%",
        "category": "Timonier"
      },
      {
        "command": "timonier.configure",
        "title": "%command.configure.title%",
        "category": "Timonier"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "timonier.openMap",
          "when": "view == timonier.home",
          "group": "navigation"
        },
        {
          "command": "timonier.openWhiteboard",
          "when": "view == timonier.home",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Timonier",
      "properties": {
        "timonier.daemon.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.daemon.path%",
          "scope": "machine"
        },
        "timonier.map.density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ],
          "enumDescriptions": [
            "%config.map.density.comfortable%",
            "%config.map.density.compact%"
          ],
          "default": "comfortable",
          "description": "%config.map.density%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "package": "vsce package --no-dependencies --out timonier.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3"
  }
}
