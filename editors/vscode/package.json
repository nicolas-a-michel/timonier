{
  "name": "timonier",
  "displayName": "Timonier",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "nicolas-a-michel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolas-a-michel/timonier.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "AI"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "timonier",
          "title": "Timonier",
          "icon": "media/timonier.svg"
        }
      ]
    },
    "views": {
      "timonier": [
        {
          "id": "timonier.home",
          "name": "%view.home.name%",
          "icon": "media/timonier.svg",
          "contextualTitle": "Timonier"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "timonier.home",
        "contents": "%view.home.welcome%"
      }
    ],
    "commands": [
      {
        "command": "timonier.openMap",
        "title": "%command.openMap.title%",
        "category": "Timonier",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "timonier.openMap",
          "when": "view == timonier.home",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && vscode-test",
    "package": "vsce package --no-dependencies --out timonier.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
